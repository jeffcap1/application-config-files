{
  "$schema": "https://opencode.ai/config.json",
  // Rules are evaluated in order; the last matching rule wins.
  // Broad allows come first, narrower ask/deny exceptions after them.
  "permissions": [
    // Defaults
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Read-only and navigation
    { "action": "shell", "resource": "cd *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "xxd *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },

    // find: allow searching; ask before deleting or running commands
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "find *-delete*", "effect": "ask" },
    { "action": "shell", "resource": "find *-exec *", "effect": "ask" },
    { "action": "shell", "resource": "find *-ok *", "effect": "ask" },

    // sed: allow printing (sed -n); ask before in-place edits
    { "action": "shell", "resource": "sed -n *", "effect": "allow" },
    { "action": "shell", "resource": "sed * -i*", "effect": "ask" },
    { "action": "shell", "resource": "sed *--in-place*", "effect": "ask" },

    // git: allow; ask before anything that rewrites or discards work
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },

    // Package managers: allow; never publish
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm *", "effect": "allow" },
    { "action": "shell", "resource": "npm publish *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm publish *", "effect": "deny" },

    // GitHub: PR reads; ask on anything that writes
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr reviews *", "effect": "allow" },
    { "action": "shell", "resource": "gh run view *", "effect": "allow" },
    { "action": "shell", "resource": "gh stack view *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "gh api repos/SteelHouse/mntn-nova/pulls/*",
      "effect": "allow",
    },
    { "action": "shell", "resource": "gh api * -f *", "effect": "ask" },
    { "action": "shell", "resource": "gh api * -F *", "effect": "ask" },
    { "action": "shell", "resource": "gh api *--field *", "effect": "ask" },
    { "action": "shell", "resource": "gh api *--raw-field *", "effect": "ask" },
    { "action": "shell", "resource": "gh api *--input *", "effect": "ask" },
    { "action": "shell", "resource": "gh api *-X *", "effect": "ask" },
    { "action": "shell", "resource": "gh api *--method *", "effect": "ask" },
  ],
  // Hard denies: project config and saved "Allow always" approvals cannot override these.
  "policies": [
    { "action": "tool.use", "resource": "shell:rm *", "effect": "deny" },
  ],
  "providers": {
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "settings": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "llama3.1:8b": {
          "name": "Llama3.1",
        },
        "qwen2.5-coder:32b": {
          "name": "Qwen 2.5 Coder",
        },
        "mistral-nemo": {
          "name": "Mistral Nemo",
        },
      },
    },
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
        },
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["zsh", "-lc", "npx -y chrome-devtools-mcp@latest"],
      },
      "storybook": {
        "type": "remote",
        "url": "http://localhost:6006/mcp",
        "disabled": true,
      },
    },
  },
  "plugins": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "experimental": {
    "todo": true,
  },
}
