{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "cd *": "allow",
      "ls *": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "xxd *": "allow",
      "git *": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "sort *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "xargs *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh pr reviews *": "allow",
      "gh run view *": "allow",
      "gh stack view *": "allow",
      "gh api repos/SteelHouse/mntn-nova/pulls/*/reviews *": "allow",
      "gh api repos/SteelHouse/mntn-nova/pulls/*/comments *": "allow"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "llama3.1:8b": {
          "name": "Llama3.1"
        },
        "qwen2.5-coder:32b": {
          "name": "Qwen 2.5 Coder"
        },
        "mistral-nemo": {
          "name": "Mistral Nemo"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "$CONTEXT7_API_KEY"
      },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["zsh", "-lc", "npx -y chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "mntn-devops": {
      "type": "remote",
      "url": "https://mcp.prod.in.mountain.com",
      "enabled": false
    },
    "mntn-devops-nonprod": {
      "type": "remote",
      "url": "https://mcp.nonprod.in.mountain.com",
      "enabled": false
    },
    "atlas-code": {
      "type": "remote",
      "url": "https://agent-gateway.management.in.mountain.com/mcp/code",
      "enabled": true
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-caveman@latest"
  ]
}
