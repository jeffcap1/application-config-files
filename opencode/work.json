{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "mntn-devops": {
        "type": "remote",
        "url": "https://mcp.prod.in.mountain.com",
        "disabled": true
      },
      "mntn-devops-nonprod": {
        "type": "remote",
        "url": "https://mcp.nonprod.in.mountain.com",
        "disabled": true
      },
      "atlas-code": {
        "type": "remote",
        "url": "https://agent-gateway.management.in.mountain.com/mcp/code"
      },
      "jira": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "--rm",
          "-i",
          "-e",
          "JIRA_URL",
          "-e",
          "JIRA_USERNAME",
          "-e",
          "JIRA_API_TOKEN",
          "ghcr.io/sooperset/mcp-atlassian:latest"
        ]
      }
    }
  }
}
